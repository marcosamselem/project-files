# Algolia credentials — copy to .env and fill in (Dashboard -> Settings -> API Keys)
# .env is gitignored; never commit real keys.

# Application ID (safe to expose)
ALGOLIA_APP_ID=

# Admin API key — server-side only, used by the indexing script. KEEP SECRET.
ALGOLIA_ADMIN_API_KEY=

# Search-only API key — safe to ship in the front-end.
ALGOLIA_SEARCH_API_KEY=

# Index name
ALGOLIA_INDEX_NAME=restaurants

# Exposed to the Vite front-end (search-only key is safe client-side).
VITE_ALGOLIA_APP_ID=
VITE_ALGOLIA_SEARCH_API_KEY=
VITE_ALGOLIA_INDEX_NAME=restaurants
